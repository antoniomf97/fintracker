# Normalize line endings to LF in the repo, regardless of OS checkout settings
* text=auto eol=lf

# Binary files — never diff or line-ending-convert these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Local databases (see backend/data/) are runtime artifacts, not source
*.db binary
*.sqlite3 binary
