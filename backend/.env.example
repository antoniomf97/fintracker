# Copy this file to .env and adjust for local development.
# .env is gitignored — never commit real secrets.

# Local dev runs on Postgres to match production. Start it with:
#   docker compose up -d db
DATABASE_URL=postgresql+psycopg://fintracker:fintracker@localhost:5432/fintracker

# SQLite fallback (no server needed) — uncomment to use instead:
# DATABASE_URL=sqlite:///./data/fintracker.db

# Single-user login. The dev defaults (admin / devpassword) work out of the box;
# set real values in production. Generate a password hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOURPASSWORD', bcrypt.gensalt()).decode())"
# AUTH_USERNAME=admin
# Single-quote the hash so its $ signs aren't treated as variables:
# AUTH_PASSWORD_HASH='$2b$12$replace-with-your-own-hash'
# Use a long random value (32+ chars) in production:
# JWT_SECRET=change-me-to-a-long-random-secret
